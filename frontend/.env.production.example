# =============================================================
# .env.production.example
# Скопіюй як /opt/3dmap/frontend/.env.production та заповни
# =============================================================

# URL до backend API
# Якщо nginx проксіює /api/ -> 127.0.0.1:8000, то:
NEXT_PUBLIC_API_URL=http://209.38.210.197/api
# Або з доменом:
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# =============================================================
# Google: SEO + Реклама (Ads). Усе ВИМКНЕНО поки порожнє.
# Деталі й покрокова інструкція: GOOGLE_ADS_SETUP.md
# =============================================================

# Google Search Console — підтвердження володіння (Settings → Ownership → HTML tag)
# Встав лише значення content="..." (БЕЗ тегів).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — вимірювання (Admin → Data Streams → Measurement ID)
NEXT_PUBLIC_GA_ID=            # G-XXXXXXXXXX

# Google Ads — відстеження конверсій (Google Ads → Tools → Conversions)
NEXT_PUBLIC_GADS_ID=          # AW-XXXXXXXXXX
# «send_to» для кожної конверсійної дії: формат "AW-XXXXXXXXXX/AbCdEf…"
NEXT_PUBLIC_GADS_LABEL_ORDER=     # головна ціль: надіслане замовлення (лід)
NEXT_PUBLIC_GADS_LABEL_CONTACT=   # контакт-форма (телефон/повідомлення)
NEXT_PUBLIC_GADS_LABEL_GENERATE=  # згенерована модель (ремаркетинг/мікроконверсія)

# Meta (Facebook/Instagram) Pixel — Meta Business Suite → Events Manager → Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=    # 15-16-значний числовий ID
